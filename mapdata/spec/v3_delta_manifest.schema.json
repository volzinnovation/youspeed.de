{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youspeed.de/spec/v3_delta_manifest.schema.json",
  "title": "youspeed v3 delta manifest",
  "type": "object",
  "required": [
    "format",
    "schema_version",
    "region",
    "from_bundle_version",
    "to_bundle_version",
    "created_at_utc",
    "patch",
    "stats"
  ],
  "properties": {
    "format": {
      "const": "youspeed.v3.delta.manifest"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "from_bundle_version": {
      "type": "string",
      "minLength": 1
    },
    "to_bundle_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
    },
    "source_diff_file": {
      "type": "string"
    },
    "patch": {
      "type": "object",
      "required": [
        "file",
        "bytes",
        "sha256"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "compression": {
          "type": "string",
          "enum": [
            "none",
            "zlib"
          ]
        }
      }
    },
    "stats": {
      "type": "object",
      "required": [
        "changed_way_count",
        "ways_added",
        "ways_removed",
        "ways_modified",
        "delete_way_count",
        "insert_way_count",
        "skipped_insert_way_count"
      ],
      "properties": {
        "changed_way_count": {
          "type": "integer",
          "minimum": 0
        },
        "ways_added": {
          "type": "integer",
          "minimum": 0
        },
        "ways_removed": {
          "type": "integer",
          "minimum": 0
        },
        "ways_modified": {
          "type": "integer",
          "minimum": 0
        },
        "maxspeed_tag_events": {
          "type": "integer",
          "minimum": 0
        },
        "maxspeed_tag_changes": {
          "type": "integer",
          "minimum": 0
        },
        "delete_way_count": {
          "type": "integer",
          "minimum": 0
        },
        "insert_way_count": {
          "type": "integer",
          "minimum": 0
        },
        "skipped_insert_way_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "additionalProperties": true
}
