{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youspeed.de/spec/v3_bundle_manifest.schema.json",
  "title": "youspeed v3 bundle manifest",
  "type": "object",
  "required": [
    "format",
    "schema_version",
    "variant",
    "region",
    "bundle_version",
    "created_at_utc",
    "min_app_version",
    "db"
  ],
  "properties": {
    "format": {
      "const": "youspeed.v3.bundle.manifest"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "variant": {
      "const": "v3"
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "country_code": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "bundle_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
    },
    "min_app_version": {
      "type": "string",
      "minLength": 1
    },
    "db": {
      "$ref": "#/$defs/artifact"
    },
    "db_parts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "delta_index": {
      "anyOf": [
        {
          "$ref": "#/$defs/artifact"
        },
        {
          "type": "null"
        }
      ]
    },
    "penalty_rules": {
      "anyOf": [
        {
          "$ref": "#/$defs/artifact"
        },
        {
          "type": "null"
        }
      ]
    },
    "coverage": {
      "type": "object",
      "required": [
        "bbox"
      ],
      "properties": {
        "bbox": {
          "$ref": "#/$defs/bbox"
        },
        "poly": {
          "anyOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "self": {
      "type": "object",
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "file",
        "bytes",
        "sha256"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "bbox": {
      "type": "object",
      "required": [
        "min_lon",
        "min_lat",
        "max_lon",
        "max_lat"
      ],
      "properties": {
        "min_lon": {
          "type": "number"
        },
        "min_lat": {
          "type": "number"
        },
        "max_lon": {
          "type": "number"
        },
        "max_lat": {
          "type": "number"
        }
      }
    }
  },
  "additionalProperties": true
}
