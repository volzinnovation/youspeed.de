{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youspeed.de/spec/tile_manifest.v2.schema.json",
  "title": "youspeed tile manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tile_id",
    "content_version",
    "generated_at_utc",
    "tile_pack_url",
    "tile_pack_bytes",
    "tile_pack_sha256",
    "bbox_wgs84",
    "stats",
    "chunks"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "tile_id": {
      "type": "string",
      "pattern": "^-?[0-9]+/-?[0-9]+$"
    },
    "content_version": {
      "type": "integer",
      "minimum": 1
    },
    "generated_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "tile_pack_url": {
      "type": "string",
      "pattern": "^https://.+"
    },
    "tile_pack_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "tile_pack_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bbox_wgs84": {
      "$ref": "#/$defs/bbox_wgs84"
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_count",
        "node_count",
        "area_count"
      ],
      "properties": {
        "segment_count": {
          "type": "integer",
          "minimum": 0
        },
        "node_count": {
          "type": "integer",
          "minimum": 0
        },
        "area_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/chunk"
      }
    }
  },
  "$defs": {
    "bbox_wgs84": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_lat",
        "min_lon",
        "max_lat",
        "max_lon"
      ],
      "properties": {
        "min_lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "min_lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "max_lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "max_lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "offset",
        "length",
        "codec"
      ],
      "properties": {
        "name": {
          "enum": [
            "segment_index",
            "segment_geom",
            "speed_rules",
            "adjacency",
            "area_index"
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "length": {
          "type": "integer",
          "minimum": 0
        },
        "codec": {
          "enum": [
            "raw",
            "zstd"
          ]
        }
      }
    }
  }
}
