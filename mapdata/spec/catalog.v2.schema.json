{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youspeed.de/spec/catalog.v2.schema.json",
  "title": "youspeed tile catalog v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "region",
    "generated_at_utc",
    "app_compat",
    "tile_grid",
    "channels",
    "tiles"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "generated_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "app_compat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_data_runtime_version",
        "max_data_runtime_version"
      ],
      "properties": {
        "min_data_runtime_version": {
          "type": "integer",
          "minimum": 1
        },
        "max_data_runtime_version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "tile_grid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crs",
        "tile_size_m"
      ],
      "properties": {
        "crs": {
          "const": "EPSG:3857"
        },
        "tile_size_m": {
          "type": "integer",
          "minimum": 256
        }
      }
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "tiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/tile_entry"
      }
    }
  },
  "$defs": {
    "bbox_wgs84": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_lat",
        "min_lon",
        "max_lat",
        "max_lon"
      ],
      "properties": {
        "min_lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "min_lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "max_lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "max_lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "tile_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tile_id",
        "tile_manifest_url",
        "tile_manifest_sha256",
        "content_version",
        "content_bytes",
        "content_sha256",
        "bbox_wgs84"
      ],
      "properties": {
        "tile_id": {
          "type": "string",
          "pattern": "^-?[0-9]+/-?[0-9]+$"
        },
        "tile_manifest_url": {
          "type": "string",
          "pattern": "^https://.+"
        },
        "tile_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "content_version": {
          "type": "integer",
          "minimum": 1
        },
        "content_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bbox_wgs84": {
          "$ref": "#/$defs/bbox_wgs84"
        }
      }
    }
  }
}
