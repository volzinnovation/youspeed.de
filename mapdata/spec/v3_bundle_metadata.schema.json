{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YouSpeed Data Manager bundle metadata",
  "type": "object",
  "required": ["format", "schema_version", "created_at_utc", "bundles"],
  "properties": {
    "format": {"const": "youspeed.v3.bundle.metadata"},
    "schema_version": {"const": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "bundles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "manifest_url", "bundle_version", "created_at_utc", "download_bytes"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "manifest_url": {"type": "string", "format": "uri"},
          "bundle_version": {"type": "string", "minLength": 1},
          "created_at_utc": {"type": "string", "format": "date-time"},
          "download_bytes": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807}
        }
      }
    }
  }
}
