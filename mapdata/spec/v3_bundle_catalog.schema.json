{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youspeed.de/spec/v3_bundle_catalog.schema.json",
  "title": "youspeed v3 country bundle catalog",
  "type": "object",
  "required": [
    "format",
    "schema_version",
    "variant",
    "country",
    "bundle_version",
    "created_at_utc",
    "max_country_pbf_bytes",
    "regions"
  ],
  "properties": {
    "format": {
      "const": "youspeed.v3.bundle.catalog"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "variant": {
      "const": "v3"
    },
    "country": {
      "type": "string",
      "minLength": 1
    },
    "bundle_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
    },
    "max_country_pbf_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "region",
          "name",
          "bundle_version",
          "manifest"
        ],
        "properties": {
          "region": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "bundle_version": {
            "type": "string",
            "minLength": 1
          },
          "manifest": {
            "$ref": "v3_bundle_manifest.schema.json#/$defs/artifact"
          },
          "coverage": {
            "type": "object",
            "required": [
              "bbox"
            ],
            "properties": {
              "bbox": {
                "$ref": "v3_bundle_manifest.schema.json#/$defs/bbox"
              },
              "poly": {
                "anyOf": [
                  {
                    "$ref": "v3_bundle_manifest.schema.json#/$defs/artifact"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
