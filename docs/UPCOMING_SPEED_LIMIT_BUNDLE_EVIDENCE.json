  "native_physical_speed_candidate_lookup": {
    "sql": {
      "forward": "SELECT a.sign_id,a.way_id,a.direction,a.station_chainage_m,s.sign_code,s.numeric_value,s.unit\nFROM traffic_sign_association a JOIN traffic_sign_runtime s ON s.sign_id=a.sign_id\nWHERE a.way_id=? AND a.direction=1 AND a.status='accepted'\n  AND a.station_chainage_m>? AND a.station_chainage_m<=?\n  AND s.kind='speed_limit' AND s.parameter_status='parsed_source_value' AND s.unit='km/h'\n  AND s.numeric_value>0 AND s.numeric_value<?\n  AND EXISTS(SELECT 1 FROM traffic_sign_way_rule r\n             WHERE r.way_id=a.way_id AND r.direction=a.direction AND r.sign_id=a.sign_id\n               AND r.association_status='accepted' AND r.lane_scope='all' AND r.speed_kmh=s.numeric_value)\nORDER BY a.station_chainage_m ASC,a.sign_id LIMIT 1",
      "reverse": "SELECT a.sign_id,a.way_id,a.direction,a.station_chainage_m,s.sign_code,s.numeric_value,s.unit\nFROM traffic_sign_association a JOIN traffic_sign_runtime s ON s.sign_id=a.sign_id\nWHERE a.way_id=? AND a.direction=-1 AND a.status='accepted'\n  AND a.station_chainage_m>=? AND a.station_chainage_m<?\n  AND s.kind='speed_limit' AND s.parameter_status='parsed_source_value' AND s.unit='km/h'\n  AND s.numeric_value>0 AND s.numeric_value<?\n  AND EXISTS(SELECT 1 FROM traffic_sign_way_rule r\n             WHERE r.way_id=a.way_id AND r.direction=a.direction AND r.sign_id=a.sign_id\n               AND r.association_status='accepted' AND r.lane_scope='all' AND r.speed_kmh=s.numeric_value)\nORDER BY a.station_chainage_m DESC,a.sign_id LIMIT 1"
    },
    "sampling_sql": "SELECT a.sign_id,a.way_id,a.direction,a.station_chainage_m,d.way_length_m,s.numeric_value\nFROM traffic_sign_association a JOIN traffic_sign_runtime s USING(sign_id)\nJOIN traffic_sign_way_direction d USING(way_id)\nWHERE a.status='accepted' AND s.kind='speed_limit' AND s.parameter_status='parsed_source_value'\nAND EXISTS(SELECT 1 FROM traffic_sign_way_rule r WHERE r.way_id=a.way_id AND r.direction=a.direction\nAND r.sign_id=a.sign_id AND r.association_status='accepted' AND r.lane_scope='all' AND r.speed_kmh=s.numeric_value)\nORDER BY a.sign_id",
