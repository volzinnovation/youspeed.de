# See Dockerfile.coreml for why the local base tag is used in FROM. The exact
# base digest is recorded and checked in the export evidence.
FROM woladen-prolix:2ad3c2382d
USER root

# LiteRT conversion is kept separate because TensorFlow/onnx2tf have a
# different dependency surface from Core ML Tools.
RUN python3 -m pip uninstall -y torch torchvision ultralytics \
    && python3 -m pip install --no-cache-dir \
    --index-url https://download.pytorch.org/whl/cpu \
    torch==2.13.0+cpu \
    torchvision==0.28.0+cpu \
    && python3 -m pip install --no-cache-dir \
    ultralytics==8.4.56 \
    onnx==1.17.0 \
    onnx2tf==1.28.8 \
    onnxslim==0.1.96 \
    onnxruntime==1.30.0 \
    onnx-graphsurgeon==0.6.1 \
    sng4onnx==2.0.1 \
    tensorflow==2.19.0 \
    tf-keras==2.19.0 \
    ai-edge-litert==1.3.0 \
    numpy==2.1.3

LABEL org.opencontainers.image.base.name="woladen-prolix:2ad3c2382d" \
      org.opencontainers.image.base.digest="sha256:c1e51a1cb1195b4471a530e7484f9bd8c3163ad7150c26207c077c1f93727607" \
      org.opencontainers.image.source="https://github.com/volzinnovation/youspeed.de/tree/main/scripts/tsr/foreign-export"

ENV YOLO_CONFIG_DIR=/tmp/Ultralytics
WORKDIR /data
USER 10001
