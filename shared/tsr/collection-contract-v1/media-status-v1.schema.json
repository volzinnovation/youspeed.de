{
  "$defs": {
    "Box": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Height",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "Box",
      "type": "object"
    },
    "SupplementaryOCRAnnotation": {
      "additionalProperties": false,
      "description": "Original on-device read provenance, independent of model classification.",
      "properties": {
        "engine": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Engine",
          "type": "string"
        },
        "first_seen_at": {
          "format": "date-time",
          "title": "First Seen At",
          "type": "string"
        },
        "frame_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Frame Id",
          "type": "string"
        },
        "model_version": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "normalized_ocr_box": {
          "anyOf": [
            {
              "$ref": "#/$defs/Box"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "normalized_primary_box": {
          "$ref": "#/$defs/Box"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "parsed_time_window": {
          "anyOf": [
            {
              "$ref": "#/$defs/SupplementaryOCRTimeWindow"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "physical_sign_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Physical Sign Id",
          "type": "string"
        },
        "primary_class_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Primary Class Id",
          "type": "string"
        },
        "primary_speed_kmh": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Primary Speed Kmh"
        },
        "raw_text": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw Text"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "enum": [
            "read",
            "no_text",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "primary_class_id",
        "primary_speed_kmh",
        "physical_sign_id",
        "frame_id",
        "observed_at",
        "first_seen_at",
        "raw_text",
        "status",
        "normalized_primary_box",
        "engine",
        "model_version"
      ],
      "title": "SupplementaryOCRAnnotation",
      "type": "object"
    },
    "SupplementaryOCRTimeWindow": {
      "additionalProperties": false,
      "description": "Parsed transcription only; no date, location or applicability evaluation.",
      "properties": {
        "end_minutes": {
          "maximum": 1439,
          "minimum": 0,
          "title": "End Minutes",
          "type": "integer"
        },
        "start_minutes": {
          "maximum": 1439,
          "minimum": 0,
          "title": "Start Minutes",
          "type": "integer"
        }
      },
      "required": [
        "start_minutes",
        "end_minutes"
      ],
      "title": "SupplementaryOCRTimeWindow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "association_status": {
      "anyOf": [
        {
          "enum": [
            "exact",
            "unresolved"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Association Status"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "crop_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Crop Id"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "observation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observation Id"
    },
    "ocr_attempt_id": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ocr Attempt Id"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "enum": [
        "missing",
        "expired",
        "linked",
        "superseded",
        "supplementary_ocr_observed"
      ],
      "title": "Status",
      "type": "string"
    },
    "superseded_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Superseded By"
    },
    "supplementary_ocr": {
      "anyOf": [
        {
          "$ref": "#/$defs/SupplementaryOCRAnnotation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "created_at",
    "crop_id",
    "status"
  ],
  "title": "MediaStatus",
  "type": "object"
}
