{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youspeed.de/schemas/tsr/model-pack-v2.json",
  "title": "YouSpeed two-stage traffic-sign shadow model pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "countries",
    "pipeline",
    "taxonomy_version",
    "execution_policy",
    "thresholds",
    "stages",
    "class_mapping",
    "lineage",
    "offline_references",
    "licenses",
    "minimum_app_version"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "pack_id": { "type": "string", "minLength": 1 },
    "countries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z]{2}$" }
    },
    "pipeline": { "const": "proposal_classification" },
    "taxonomy_version": { "const": "tsr-semantic-v2" },
    "execution_policy": { "$ref": "#/$defs/executionPolicy" },
    "thresholds": { "$ref": "#/$defs/thresholds" },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detector", "classifier"],
      "properties": {
        "detector": {
          "allOf": [
            { "$ref": "#/$defs/stage" },
            {
              "properties": {
                "role": { "const": "proposal_detector" },
                "preprocessing": {
                  "properties": {
                    "source": { "const": "full_frame" },
                    "crop_policy": { "type": "null" }
                  }
                }
              }
            }
          ]
        },
        "classifier": {
          "allOf": [
            { "$ref": "#/$defs/stage" },
            {
              "properties": {
                "role": { "const": "semantic_classifier" },
                "preprocessing": {
                  "properties": {
                    "source": { "const": "proposal_crop" },
                    "crop_policy": { "$ref": "#/$defs/cropPolicy" }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "class_mapping": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/classMapping" }
    },
    "lineage": { "$ref": "#/$defs/lineage" },
    "offline_references": {
      "type": "array",
      "items": { "$ref": "#/$defs/offlineReference" }
    },
    "licenses": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/license" }
    },
    "minimum_app_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "signature": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "key_id", "value"],
          "properties": {
            "algorithm": { "const": "ed25519" },
            "key_id": { "type": "string", "minLength": 1 },
            "value": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "executionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial_mode",
        "override_eligible",
        "required_gates",
        "gate_status"
      ],
      "properties": {
        "initial_mode": { "const": "shadow" },
        "override_eligible": { "const": false },
        "required_gates": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": ["holdout", "parity", "device", "temporal", "license"]
          }
        },
        "gate_status": {
          "type": "object",
          "additionalProperties": false,
          "required": ["holdout", "parity", "device", "temporal", "license"],
          "properties": {
            "holdout": { "$ref": "#/$defs/gateStatus" },
            "parity": { "$ref": "#/$defs/gateStatus" },
            "device": { "$ref": "#/$defs/gateStatus" },
            "temporal": { "$ref": "#/$defs/gateStatus" },
            "license": { "$ref": "#/$defs/gateStatus" }
          }
        }
      }
    },
    "gateStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_sha256"],
      "properties": {
        "status": { "enum": ["pending", "failed", "passed"] },
        "evidence_sha256": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detector_proposal",
        "classifier_confirmed",
        "restriction_readable",
        "confirmation_frames",
        "confirmation_window_ms",
        "minimum_track_iou",
        "association_policy",
        "stable_observation_hint_can_override_iou",
        "fallback_requires_unique_candidate"
      ],
      "properties": {
        "detector_proposal": { "type": "number", "minimum": 0, "maximum": 1 },
        "classifier_confirmed": { "type": "number", "minimum": 0, "maximum": 1 },
        "restriction_readable": { "type": "number", "minimum": 0, "maximum": 1 },
        "confirmation_frames": { "type": "integer", "minimum": 2 },
        "confirmation_window_ms": { "type": "integer", "minimum": 1 },
        "minimum_track_iou": { "type": "number", "minimum": 0, "maximum": 1 },
        "association_policy": {
          "const": "stable_observation_hint_then_unique_semantic_road_direction"
        },
        "stable_observation_hint_can_override_iou": { "const": true },
        "fallback_requires_unique_candidate": { "const": true }
      }
    },
    "cropPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_expansion_ratio",
        "include_linked_objects",
        "role_hint_required",
        "minimum_crop_pixels",
        "out_of_frame_fill"
      ],
      "properties": {
        "context_expansion_ratio": { "type": "number", "minimum": 0 },
        "include_linked_objects": { "const": false },
        "role_hint_required": { "const": true },
        "minimum_crop_pixels": { "type": "integer", "minimum": 1 },
        "out_of_frame_fill": { "enum": ["letterbox", "edge"] }
      }
    },
    "preprocessing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "source",
        "input_width",
        "input_height",
        "color_space",
        "layout",
        "input_dtype",
        "resize",
        "interpolation",
        "interpolation_coordinate_transform",
        "letterbox_alignment",
        "geometry_rounding",
        "orientation",
        "scale",
        "mean",
        "std",
        "normalization_formula",
        "letterbox_value",
        "crop_policy"
      ],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "source": { "enum": ["full_frame", "proposal_crop"] },
        "input_width": { "type": "integer", "minimum": 1 },
        "input_height": { "type": "integer", "minimum": 1 },
        "color_space": { "enum": ["rgb", "bgr"] },
        "layout": { "enum": ["nchw", "nhwc"] },
        "input_dtype": { "enum": ["float32", "float16", "uint8", "int8"] },
        "resize": { "enum": ["scale_fit_letterbox", "scale_fill_center_crop"] },
        "interpolation": { "enum": ["bilinear", "bicubic", "nearest"] },
        "interpolation_coordinate_transform": {
          "enum": ["half_pixel_centers", "align_corners", "asymmetric"]
        },
        "letterbox_alignment": { "enum": ["centered", "top_left", "not_applicable"] },
        "geometry_rounding": {
          "enum": [
            "floor_top_left_remainder_bottom_right",
            "round_half_up"
          ]
        },
        "orientation": { "const": "normalize_exif_and_mirroring" },
        "scale": { "type": "number", "exclusiveMinimum": 0 },
        "mean": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number" }
        },
        "std": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number", "exclusiveMinimum": 0 }
        },
        "normalization_formula": { "const": "((channel*scale)-mean)/std" },
        "letterbox_value": { "type": "number", "minimum": 0, "maximum": 255 },
        "crop_policy": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/cropPolicy" }]
        }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calibration_id",
        "method",
        "dataset_id",
        "dataset_sha256",
        "parameters_sha256",
        "runtime_output",
        "expected_calibration_error",
        "passed"
      ],
      "properties": {
        "calibration_id": { "type": "string", "minLength": 1 },
        "method": { "enum": ["temperature_scaling", "isotonic", "platt"] },
        "dataset_id": { "type": "string", "minLength": 1 },
        "dataset_sha256": { "$ref": "#/$defs/sha256" },
        "parameters_sha256": { "$ref": "#/$defs/sha256" },
        "runtime_output": { "enum": ["raw_score", "calibrated_confidence"] },
        "expected_calibration_error": { "type": "number", "minimum": 0, "maximum": 1 },
        "passed": { "type": "boolean" }
      }
    },
    "exporter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "configuration_sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "configuration_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "parity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_artifact_id",
        "corpus_sha256",
        "tolerance",
        "measured_max_abs_difference",
        "passed"
      ],
      "properties": {
        "reference_artifact_id": { "type": "string", "minLength": 1 },
        "corpus_sha256": { "$ref": "#/$defs/sha256" },
        "tolerance": { "type": "number", "minimum": 0 },
        "measured_max_abs_difference": { "type": "number", "minimum": 0 },
        "passed": { "type": "boolean" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_family_id",
        "role",
        "format",
        "platform",
        "path",
        "sha256",
        "byte_length",
        "derived_from_artifact_id",
        "input_shape",
        "output_schema",
        "precision",
        "minimum_runtime",
        "exporter",
        "parity"
      ],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "artifact_family_id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["checkpoint", "onnx", "coreml", "litert"] },
        "format": { "enum": ["checkpoint", "onnx", "coreml", "litert"] },
        "platform": { "enum": ["training", "reference", "ios", "android"] },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_length": { "type": "integer", "minimum": 1 },
        "derived_from_artifact_id": { "type": ["string", "null"], "minLength": 1 },
        "input_shape": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "integer", "minimum": 1 }
        },
        "output_schema": { "type": "string", "minLength": 1 },
        "precision": { "enum": ["float32", "float16", "int8", "uint8"] },
        "minimum_runtime": { "type": ["string", "null"], "minLength": 1 },
        "exporter": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/exporter" }]
        },
        "parity": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/parity" }]
        }
      }
    },
    "artifactSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint", "onnx", "coreml", "litert"],
      "properties": {
        "checkpoint": {
          "allOf": [
            { "$ref": "#/$defs/artifact" },
            {
              "properties": {
                "role": { "const": "checkpoint" },
                "format": { "const": "checkpoint" },
                "platform": { "const": "training" },
                "derived_from_artifact_id": { "type": "null" },
                "exporter": { "type": "null" },
                "parity": { "type": "null" }
              }
            }
          ]
        },
        "onnx": {
          "allOf": [
            { "$ref": "#/$defs/artifact" },
            {
              "properties": {
                "role": { "const": "onnx" },
                "format": { "const": "onnx" },
                "platform": { "const": "reference" }
              }
            }
          ]
        },
        "coreml": {
          "allOf": [
            { "$ref": "#/$defs/artifact" },
            {
              "properties": {
                "role": { "const": "coreml" },
                "format": { "const": "coreml" },
                "platform": { "const": "ios" }
              }
            }
          ]
        },
        "litert": {
          "allOf": [
            { "$ref": "#/$defs/artifact" },
            {
              "properties": {
                "role": { "const": "litert" },
                "format": { "const": "litert" },
                "platform": { "const": "android" }
              }
            }
          ]
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "component_id",
        "architecture",
        "preprocessing",
        "calibration",
        "artifacts"
      ],
      "properties": {
        "role": { "enum": ["proposal_detector", "semantic_classifier"] },
        "component_id": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "preprocessing": { "$ref": "#/$defs/preprocessing" },
        "calibration": { "$ref": "#/$defs/calibration" },
        "artifacts": { "$ref": "#/$defs/artifactSet" }
      }
    },
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": [
            "maximum_speed",
            "maximum_speed_end",
            "zone_start",
            "zone_end",
            "restriction_end",
            "supplementary_restriction",
            "unknown"
          ]
        },
        "value": { "type": ["integer", "null"], "minimum": 1 },
        "unit": { "enum": ["km/h", "mph", null] },
        "restriction_kind": {
          "enum": [
            "weather",
            "time_window",
            "days_of_week",
            "vehicle",
            "max_weight",
            "school",
            "resident",
            "exception",
            "distance",
            "direction",
            "extent",
            "text",
            "other",
            "unknown",
            null
          ]
        }
      }
    },
    "classMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class_id", "output_index", "sign_role", "semantic"],
      "properties": {
        "class_id": { "type": "string", "minLength": 1 },
        "output_index": { "type": "integer", "minimum": 0 },
        "sign_role": { "enum": ["primary_sign", "supplementary_plate"] },
        "semantic": { "$ref": "#/$defs/semantic" }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taxonomy_sha256",
        "source_manifest_sha256",
        "full_scene_annotation_manifest_sha256",
        "group_split_manifest_sha256",
        "training_run_id",
        "training_run_sha256",
        "evaluation_report_sha256",
        "parity_report_sha256"
      ],
      "properties": {
        "taxonomy_sha256": { "$ref": "#/$defs/sha256" },
        "source_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "full_scene_annotation_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "group_split_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "training_run_id": { "type": "string", "minLength": 1 },
        "training_run_sha256": { "$ref": "#/$defs/sha256" },
        "evaluation_report_sha256": { "$ref": "#/$defs/sha256" },
        "parity_report_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "offlineReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_id",
        "role",
        "revision",
        "artifact_sha256",
        "runtime_included",
        "acceptance_gate_eligible"
      ],
      "properties": {
        "reference_id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["offline_teacher", "offline_crop_benchmark"] },
        "revision": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "runtime_included": { "const": false },
        "acceptance_gate_eligible": { "const": false }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "spdx", "source", "review_status"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "spdx": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "format": "uri" },
        "review_status": { "enum": ["pending", "approved", "rejected"] }
      }
    }
  }
}
