{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic experimental path-evidence fixture v1",
  "type": "object",
  "required": ["schemaVersion", "provenance", "description", "boundaryCases", "pathCases"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "provenance": {"const": "synthetic_engineering_only"},
    "description": {"type": "string"},
    "boundaryCases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/boundary"}},
    "pathCases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/path"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "point": {"type": "object", "required": ["x", "y"], "additionalProperties": false, "properties": {"x": {"type": "number"}, "y": {"type": "number"}}},
    "boundary": {
      "type": "object", "required": ["id", "width", "height", "background", "strokes", "expected"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "width": {"type": "integer", "minimum": 64, "maximum": 384},
        "height": {"type": "integer", "minimum": 64, "maximum": 216},
        "background": {"type": "integer", "minimum": 0, "maximum": 255},
        "noiseSeed": {"type": "integer"}, "maximumOperations": {"type": "integer", "minimum": 0},
        "strokes": {"type": "array", "items": {"type": "object", "required": ["points", "width", "brightness"], "additionalProperties": false,
          "properties": {"points": {"type": "array", "minItems": 2, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 1}}},
            "width": {"type": "number", "exclusiveMinimum": 0}, "brightness": {"type": "integer", "minimum": 0, "maximum": 255}}}},
        "expected": {"type": "object"}
      }
    },
    "path": {
      "type": "object", "required": ["id", "scope", "nowSeconds", "calibration", "poses", "observations", "corridors", "expected"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "scope": {"type": "string"}, "nowSeconds": {"type": "number"},
        "calibration": {"type": ["object", "null"], "required": ["revision", "verified", "fx", "fy", "cx", "cy", "yawDegrees", "pitchDegrees", "rollDegrees", "heightMeters", "lateralOffsetMeters"]},
        "poses": {"type": "array", "items": {"type": "object", "required": ["scope", "timeSeconds", "eastMeters", "northMeters", "courseDegrees", "speedMetersPerSecond", "horizontalAccuracyMeters", "courseAccuracyDegrees"]}},
        "observations": {"type": "array", "items": {"type": "object", "required": ["trackId", "scope", "calibrationRevision", "timeSeconds", "imageX", "imageY"]}},
        "corridors": {"type": "array", "items": {"type": "object", "required": ["id", "role", "polygon", "confidence", "independentlySupported", "roadsideMarginMeters"],
          "properties": {"polygon": {"type": "array", "items": {"$ref": "#/$defs/point"}}, "role": {"enum": ["current_path", "other_path", "unknown"]}}}},
        "expected": {"type": "object", "required": ["classification"], "properties": {"classification": {"enum": ["current_path", "other_path", "unknown"]}}}
      }
    }
  }
}
