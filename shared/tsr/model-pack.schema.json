{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youspeed.de/schemas/tsr/model-pack-v1.json",
  "title": "YouSpeed traffic-sign model pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "countries",
    "pipeline",
    "taxonomy_version",
    "preprocessing",
    "thresholds",
    "calibration",
    "class_mapping",
    "detector",
    "lineage",
    "licenses",
    "minimum_app_version"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "pack_id": { "type": "string", "minLength": 1 },
    "countries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z]{2}$" }
    },
    "pipeline": {
      "enum": ["direct_detection", "proposal_classification"]
    },
    "taxonomy_version": { "const": "tsr-semantic-v1" },
    "preprocessing": { "$ref": "#/$defs/preprocessing" },
    "thresholds": { "$ref": "#/$defs/thresholds" },
    "calibration": { "$ref": "#/$defs/calibration" },
    "class_mapping": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/classMapping" }
    },
    "detector": { "$ref": "#/$defs/component" },
    "classifier": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/component" }
      ]
    },
    "lineage": { "$ref": "#/$defs/lineage" },
    "licenses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "spdx", "source"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "spdx": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 }
        }
      }
    },
    "minimum_app_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "signature": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "key_id", "value"],
          "properties": {
            "algorithm": { "const": "ed25519" },
            "key_id": { "type": "string", "minLength": 1 },
            "value": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "preprocessing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "input_width", "input_height", "color_space", "resize", "orientation"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "input_width": { "type": "integer", "minimum": 1 },
        "input_height": { "type": "integer", "minimum": 1 },
        "color_space": { "enum": ["rgb", "bgr"] },
        "resize": { "enum": ["scale_fit_letterbox", "scale_fill"] },
        "orientation": { "const": "normalize_exif_and_mirroring" }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provisional", "confirmed", "unknown", "confirmation_frames", "confirmation_window_ms", "minimum_track_iou"],
      "properties": {
        "provisional": { "type": "number", "minimum": 0, "maximum": 1 },
        "confirmed": { "type": "number", "minimum": 0, "maximum": 1 },
        "unknown": { "type": "number", "minimum": 0, "maximum": 1 },
        "confirmation_frames": { "type": "integer", "minimum": 2 },
        "confirmation_window_ms": { "type": "integer", "minimum": 1 },
        "minimum_track_iou": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "revision", "dataset_sha256", "calibrated", "runtime_output"],
      "properties": {
        "kind": { "enum": ["none", "temperature_scaling", "isotonic", "platt"] },
        "revision": { "type": "string", "minLength": 1 },
        "dataset_sha256": { "$ref": "#/$defs/sha256" },
        "calibrated": { "type": "boolean" },
        "runtime_output": { "enum": ["raw_score", "calibrated_confidence"] }
      }
    },
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": [
            "maximum_speed",
            "zone_start",
            "zone_end",
            "restriction_end",
            "city_entry",
            "city_exit",
            "pedestrian_zone_start",
            "pedestrian_zone_end",
            "temporary",
            "unknown"
          ]
        },
        "value": { "type": "integer", "minimum": 1 },
        "unit": { "enum": ["km/h", "mph"] }
      }
    },
    "classMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class_id", "label", "semantic", "threshold"],
      "properties": {
        "class_id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "semantic": { "$ref": "#/$defs/semantic" },
        "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "sign_role": {
          "enum": ["primary_sign", "supplementary_plate"],
          "default": "primary_sign"
        },
        "restriction": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/restriction" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["sign_role"],
            "properties": { "sign_role": { "const": "supplementary_plate" } }
          },
          "then": {
            "required": ["restriction"],
            "properties": {
              "semantic": {
                "type": "object",
                "required": ["kind"],
                "properties": { "kind": { "const": "unknown" } },
                "not": {
                  "anyOf": [
                    { "required": ["value"] },
                    { "required": ["unit"] }
                  ]
                }
              },
              "restriction": { "$ref": "#/$defs/restriction" }
            }
          },
          "else": {
            "properties": { "restriction": { "type": "null" } }
          }
        }
      ]
    },
    "restriction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "normalized_value"],
      "properties": {
        "kind": {
          "enum": [
            "weather",
            "time_window",
            "days_of_week",
            "vehicle",
            "max_weight",
            "school",
            "resident",
            "exception",
            "distance",
            "direction",
            "extent",
            "text",
            "other",
            "unknown"
          ]
        },
        "normalized_value": { "type": "string", "minLength": 1 },
        "raw_text": { "type": "string", "minLength": 1 },
        "country_sign_code": { "type": "string", "minLength": 1 }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "source_checkpoint", "artifacts"],
      "properties": {
        "component_id": { "type": "string", "minLength": 1 },
        "source_checkpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["uri", "revision", "sha256"],
          "properties": {
            "uri": { "type": "string", "minLength": 1 },
            "revision": { "type": "string", "minLength": 1 },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_manifest_sha256",
        "dataset_inventory_sha256s",
        "training_run_id",
        "training_run_sha256",
        "evaluation_report_sha256",
        "parity_report_sha256"
      ],
      "properties": {
        "source_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "dataset_inventory_sha256s": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "training_run_id": { "type": "string", "minLength": 1 },
        "training_run_sha256": { "$ref": "#/$defs/sha256" },
        "evaluation_report_sha256": { "$ref": "#/$defs/sha256" },
        "parity_report_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "minimum_runtime",
        "format",
        "precision",
        "input_shape",
        "output_schema",
        "path",
        "sha256",
        "source_checkpoint_sha256",
        "exporter",
        "calibration_dataset_sha256",
        "parity"
      ],
      "properties": {
        "platform": { "enum": ["ios", "android", "reference"] },
        "minimum_runtime": { "type": "string", "minLength": 1 },
        "format": { "enum": ["coreml", "tflite", "onnx"] },
        "precision": { "enum": ["float32", "float16", "int8", "uint8"] },
        "input_shape": {
          "type": "array",
          "minItems": 3,
          "maxItems": 4,
          "items": { "type": "integer", "minimum": 1 }
        },
        "output_schema": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "source_checkpoint_sha256": { "$ref": "#/$defs/sha256" },
        "exporter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "configuration"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "configuration": { "type": "string", "minLength": 1 }
          }
        },
        "calibration_dataset_sha256": { "$ref": "#/$defs/sha256" },
        "parity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tolerance", "measured_max_abs_difference", "passed"],
          "properties": {
            "tolerance": { "type": "number", "minimum": 0 },
            "measured_max_abs_difference": { "type": "number", "minimum": 0 },
            "passed": { "type": "boolean" }
          }
        }
      }
    }
  }
}
