{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youspeed.de/schemas/tsr/full-scene-annotation-v2.json",
  "title": "YouSpeed frozen full-scene traffic-sign annotations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "taxonomy_version",
    "frozen",
    "coordinate_system",
    "frames"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "manifest_id": { "type": "string", "minLength": 1 },
    "taxonomy_version": { "const": "tsr-semantic-v2" },
    "frozen": { "const": true },
    "coordinate_system": {
      "const": "pixel_xywh_top_left_after_orientation_normalization"
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/frame" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "pixelRect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "status", "evidence_uri"],
      "properties": {
        "spdx": { "type": ["string", "null"], "minLength": 1 },
        "status": { "enum": ["pending_review", "verified", "not_applicable"] },
        "evidence_uri": { "type": ["string", "null"], "format": "uri" }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "verified" } }
          },
          "then": {
            "properties": {
              "spdx": { "type": "string", "minLength": 1 },
              "evidence_uri": { "type": "string", "format": "uri" }
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "kind",
        "source_asset_id",
        "sequence_id",
        "source_page_uri",
        "source_asset_uri",
        "source_split_id",
        "published_split_reuse",
        "license"
      ],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "zod_reviewed",
            "youspeed_reviewed",
            "reviewed_synthetic",
            "panoramax_public_fixture"
          ]
        },
        "source_asset_id": { "type": "string", "minLength": 1 },
        "sequence_id": { "type": ["string", "null"], "minLength": 1 },
        "source_page_uri": { "type": ["string", "null"], "format": "uri" },
        "source_asset_uri": { "type": ["string", "null"], "format": "uri" },
        "source_split_id": { "type": ["string", "null"], "minLength": 1 },
        "published_split_reuse": { "const": false },
        "license": { "$ref": "#/$defs/license" }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "width", "height"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "method",
        "geometry_quality",
        "reviewed_at",
        "revision"
      ],
      "properties": {
        "status": { "enum": ["accepted", "corrected"] },
        "method": { "enum": ["human", "human_verified_synthetic"] },
        "geometry_quality": { "enum": ["approximate_manual", "verified"] },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "revision": { "type": "string", "minLength": 1 }
      }
    },
    "visibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["occluded", "truncated", "difficult"],
      "properties": {
        "occluded": { "type": "boolean" },
        "truncated": { "type": "boolean" },
        "difficult": { "type": "boolean" }
      }
    },
    "primarySemantic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class_id", "kind", "value", "unit"],
      "properties": {
        "class_id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "maximum_speed",
            "maximum_speed_end",
            "zone_start",
            "zone_end",
            "restriction_end",
            "unknown"
          ]
        },
        "value": { "type": ["integer", "null"], "minimum": 1 },
        "unit": { "enum": ["km/h", "mph", null] }
      }
    },
    "restriction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "normalized_value"],
      "properties": {
        "kind": {
          "enum": [
            "weather",
            "time_window",
            "days_of_week",
            "vehicle",
            "max_weight",
            "school",
            "resident",
            "exception",
            "distance",
            "direction",
            "extent",
            "text",
            "other",
            "unknown"
          ]
        },
        "normalized_value": { "type": "string", "minLength": 1 },
        "distance_m": { "type": ["integer", "null"], "minimum": 1 },
        "extent_m": { "type": ["integer", "null"], "minimum": 1 },
        "raw_text": { "type": ["string", "null"] },
        "country_sign_code": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": {
            "required": ["kind"],
            "properties": { "kind": { "const": "distance" } }
          },
          "then": {
            "required": ["distance_m"],
            "properties": { "distance_m": { "type": "integer", "minimum": 1 } }
          }
        },
        {
          "if": {
            "required": ["kind"],
            "properties": { "kind": { "const": "extent" } }
          },
          "then": {
            "required": ["extent_m"],
            "properties": { "extent_m": { "type": "integer", "minimum": 1 } }
          }
        }
      ]
    },
    "restrictionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "restriction"],
      "properties": {
        "state": { "enum": ["readable", "unreadable"] },
        "restriction": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/restriction" }]
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["state"],
            "properties": { "state": { "const": "unreadable" } }
          },
          "then": { "properties": { "restriction": { "type": "null" } } }
        },
        {
          "if": {
            "required": ["state"],
            "properties": { "state": { "const": "readable" } }
          },
          "then": { "properties": { "restriction": { "$ref": "#/$defs/restriction" } } }
        }
      ]
    },
    "annotationObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "physical_sign_id",
        "assembly_id",
        "role",
        "bounding_box",
        "visibility",
        "readability",
        "semantic",
        "restriction_evidence"
      ],
      "properties": {
        "object_id": { "type": "string", "minLength": 1 },
        "physical_sign_id": { "type": "string", "minLength": 1 },
        "assembly_id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["primary_sign", "supplementary_plate"] },
        "bounding_box": { "$ref": "#/$defs/pixelRect" },
        "visibility": { "$ref": "#/$defs/visibility" },
        "readability": { "enum": ["readable", "unreadable", "not_applicable"] },
        "semantic": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/primarySemantic" }]
        },
        "restriction_evidence": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/restrictionEvidence" }]
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["role"],
            "properties": { "role": { "const": "primary_sign" } }
          },
          "then": {
            "properties": {
              "semantic": { "$ref": "#/$defs/primarySemantic" },
              "restriction_evidence": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "required": ["role"],
            "properties": { "role": { "const": "supplementary_plate" } }
          },
          "then": {
            "properties": {
              "semantic": { "type": "null" },
              "readability": { "enum": ["readable", "unreadable"] },
              "restriction_evidence": { "$ref": "#/$defs/restrictionEvidence" }
            }
          }
        }
      ]
    },
    "assembly": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assembly_id",
        "physical_sign_id",
        "primary_object_id",
        "supplementary_object_ids"
      ],
      "properties": {
        "assembly_id": { "type": "string", "minLength": 1 },
        "physical_sign_id": { "type": "string", "minLength": 1 },
        "primary_object_id": { "type": "string", "minLength": 1 },
        "supplementary_object_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_id",
        "drive_id",
        "source",
        "image",
        "review",
        "objects",
        "assemblies"
      ],
      "properties": {
        "frame_id": { "type": "string", "minLength": 1 },
        "drive_id": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/source" },
        "image": { "$ref": "#/$defs/image" },
        "review": { "$ref": "#/$defs/review" },
        "objects": {
          "type": "array",
          "items": { "$ref": "#/$defs/annotationObject" }
        },
        "assemblies": {
          "type": "array",
          "items": { "$ref": "#/$defs/assembly" }
        }
      }
    }
  }
}
