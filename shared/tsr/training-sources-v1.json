  "as_of_date": "2026-09-01",
  "release_policy": {
    "default": "blocked_until_every_lineage_gate_is_approved",
    "requirements": [
      "Verify every selected artifact against this manifest before use.",
      "Record a SHA-256 inventory for every acquired dataset snapshot before training.",
      "Preserve attribution, notices, and share-alike obligations for every training input.",
      "Record the complete training lineage in the signed mobile model pack.",
      "Confirm the requested ZOD dataset snapshot with the provider after access, and treat only frames with a present and complete Traffic Signs annotation task as eligible hard negatives.",
      "Do not release the pinned Panoramax classifier or a derivative until both its CC-BY-SA-4.0 dataset lineage/share-alike obligations and its Ultralytics YOLO26 AGPL-3.0-or-Enterprise obligations are explicitly approved.",
      "Do not release a model pack containing an Ultralytics YOLO26 derivative unless the ultralytics_agpl_or_enterprise gate is explicitly approved.",
      "Do not release until route-held-out evaluation, calibration, mobile export parity, and signing gates pass."
    ],
    "license_gates": {
      "apache_notice_review": {
        "default_decision": "blocked_pending_weight_and_lineage_review",
        "reason": "The repository or model card declares Apache-2.0, but release of a pretrained checkpoint remains blocked until the weight license, upstream training-data lineage, and applicable license/NOTICE obligations are explicitly documented."
      },
      "attribution_review": {
        "default_decision": "allow_after_attribution_review",
        "reason": "Record the source attribution and indicate modifications before publication."
      },
      "attribution_share_alike_review": {
        "default_decision": "blocked_pending_legal_review",
        "reason": "Confirm attribution and share-alike treatment for the dataset, labels, derived data, and released model before publication."
      },
      "panoramax_cc_by_sa_and_ultralytics_review": {
        "default_decision": "blocked",
        "requires": [
          "attribution_share_alike_review",
          "ultralytics_agpl_or_enterprise"
        ],
        "reason": "The Panoramax classifier model card is Etalab-2.0, but the checkpoint declares both the CC-BY-SA-4.0 Panoramax classified crop dataset and Ultralytics YOLO26 lineage. Release requires an explicit decision for the dataset attribution/share-alike treatment and either AGPL-3.0 compliance for the Ultralytics derivative or an applicable Ultralytics Enterprise license."
      },
      "ultralytics_agpl_or_enterprise": {
        "default_decision": "blocked",
        "reason": "A public release must either comply with the Ultralytics AGPL-3.0 terms for code and models or be covered by an applicable Ultralytics Enterprise license."
      }
    }
  },
