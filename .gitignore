# OS/editor noise
.DS_Store
*.swp
*.swo
*~

# Python
__pycache__/
*.py[cod]

# Local build/runtime outputs
.tmp/
*.tmp
*.log

# Map data generated artifacts (very large)
mapdata/raw/*.osm.pbf
mapdata/raw/archive/
mapdata/build/**
mapdata/dist/**
mapdata/dist-v2/**
mapdata/dist-v3/**
mapdata/dist-v4/**
mapdata/bundles/**/*.sqlite
mapdata/bundles/**/*.sql
mapdata/bundles/**/*.sql.gz

# Keep lightweight mapdata metadata/spec/docs
!mapdata/build/.gitkeep
!mapdata/dist/.gitkeep
!mapdata/raw/.gitkeep
!mapdata/README.md
!mapdata/spec/**
!mapdata/reports/change_tracking.csv
mapdata/reports/deltas/**
mapdata/reports/*.json
!mapdata/reports/change_tracking.csv
!mapdata/reports/deltas/
!mapdata/reports/deltas/daily-diff-analysis.csv

# Paper build artifacts
paper/itsc2026/*.aux
paper/itsc2026/*.bbl
paper/itsc2026/*.blg
paper/itsc2026/*.fdb_latexmk
paper/itsc2026/*.fls
paper/itsc2026/*.log
paper/itsc2026/*.out
paper/itsc2026/*.synctex.gz
paper/techreport/*.aux
paper/techreport/*.bbl
paper/techreport/*.blg
paper/techreport/*.fdb_latexmk
paper/techreport/*.fls
paper/techreport/*.log
paper/techreport/*.out
paper/techreport/*.synctex.gz
paper/techreport/data/.device_benchmark_report*.swp

# iPhone generated/embedded benchmark DB artifacts
iphone/SpeedDBBenchSketch/*.sqlite
iphone/.derived/
iphone/DerivedData*/
iphone/SpeedDBBench.xcodeproj/project.xcworkspace/xcuserdata/
*.xcuserstate

# Xcode and test bundles
*.xcresult
DerivedData/
