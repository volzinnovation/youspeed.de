# OS/editor noise
.DS_Store
*.swp
*.swo
*~

# Python
__pycache__/
*.py[cod]

# JavaScript/static-site tooling
node_modules/
npm-debug.log*
.parcel-cache/
coverage/

# Local build/runtime outputs
.codex-tmp/
.tmp/
tmp/
*.tmp
*.log
main.aux
main.fdb_latexmk
main.fls

# Local driving logs with personal data
inspector/*.ndjson
inspector/logs/

# Map data generated artifacts (very large)
mapdata/raw/*.osm.pbf
mapdata/raw/archive/
mapdata/build/**
mapdata/dist/**
mapdata/dist-v2/**
mapdata/dist-v3/**
mapdata/dist-v4/**
mapdata/bundles/**/*.sqlite
mapdata/bundles/**/*.sql
mapdata/bundles/**/*.sql.gz
mapdata/bundles/**/deltas/
mapdata/bench/**

# Keep lightweight mapdata metadata/spec/docs
!mapdata/build/.gitkeep
!mapdata/bench/.gitkeep
!mapdata/dist/.gitkeep
!mapdata/raw/.gitkeep
!mapdata/README.md
!mapdata/spec/**
!mapdata/reports/change_tracking.csv
mapdata/reports/deltas/**
mapdata/reports/*.json
!mapdata/reports/change_tracking.csv
!mapdata/reports/deltas/
!mapdata/reports/deltas/daily-diff-analysis.csv

