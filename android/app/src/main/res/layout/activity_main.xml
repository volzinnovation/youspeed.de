<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1E7D0"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/header_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/header_title"
            android:textColor="#112B1F"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subheader_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/header_summary"
            android:textColor="#3D534A"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#FFF9EE"
            android:fontFamily="monospace"
            android:padding="16dp"
            android:textColor="#19382A"
            android:textSize="14sp" />

        <Button
            android:id="@+id/refresh_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="#1F5B45"
            android:text="@string/action_refresh"
            android:textAllCaps="false"
            android:textColor="#FFF9EE" />

        <Button
            android:id="@+id/fetch_manifest_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#D46A1D"
            android:text="@string/action_fetch_manifest"
            android:textAllCaps="false"
            android:textColor="#FFF9EE" />

        <Button
            android:id="@+id/bootstrap_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#8A2F2A"
            android:text="@string/action_bootstrap"
            android:textAllCaps="false"
            android:textColor="#FFF9EE" />
    </LinearLayout>

</ScrollView>
